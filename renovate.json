{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "automergeSchedule": ["* 0-3 1 * *"],
  "schedule": ["* 8-17 * * 1-5"],
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "ignoreTests": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchDepTypes": ["devdependencies"],
      "automerge": true
    }
  ]
}