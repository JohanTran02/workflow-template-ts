{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "ignoreTests": false,
  "assignAutomerge": true,
  "timezone": "Europe/Paris",
  "minimumReleaseAge": "14 days",
  "automerge": true,
  "automergeStrategy": "rebase",
  "automergeType": "pr",
  "packageRules": [
    {
      "internalChecksFilter": "strict",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Schedule non-major updates during typical non-office hours on weekdays (10 PM - 5 AM)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "schedule": "* 0-4,22-23 * * 1-5",
      "groupName": "devDependencies (non-major)",
      "automergeType": "pr",
      "automergeStrategy": "rebase",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": true
    },
    {
      "description": "Automerge lint and format updates",
      "matchPackageNames": ["oxfmt", "oxlint"],
      "groupName": "oxlint_oxfmt devDependencies (non-major)",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automergeType": "pr",
      "automergeStrategy": "rebase",
      "automerge": true
    }
  ]
}